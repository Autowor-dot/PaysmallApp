# LipaLink API hardening
Options -Indexes

# Never serve the configuration, shared libraries or schema directly
<FilesMatch "^(config|config\.local|payments-lib)\.php$|\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "no-store"
</IfModule>
