# LipaLink web root
Options -Indexes

<IfModule mod_headers.c>
    # Always revalidate pages and API responses so deployments show up immediately
    <FilesMatch "\.(html|php|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # Static assets can be cached for a week
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Keep repository housekeeping files private
<FilesMatch "^(README\.md|netlify\.toml|\.gitignore|DEPLOYMENT\.local\.md|CREDITS\.md|maintenance\.flag)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Maintenance mode (toggled in admin/settings.php, which creates/removes maintenance.flag).
# Public pages redirect to maintenance.html; /admin, /api and /assets keep working.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{DOCUMENT_ROOT}/maintenance.flag -f
    RewriteCond %{REQUEST_URI} !^/(admin|api|assets)/
    RewriteCond %{REQUEST_URI} !maintenance\.html$
    RewriteRule ^(.*\.html)?$ maintenance.html [R=302,L]
</IfModule>
